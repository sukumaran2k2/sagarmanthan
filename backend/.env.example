# Database Configuration
# For local Node (not Docker): use 127.0.0.1 or localhost
# For Docker Compose on Windows/Mac: use host.docker.internal
DB_HOST=host.docker.internal
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=sagarmanthan_revamp

# Application Server Port & JWT Secrets
PORT=3000
JWT_SECRET=your_jwt_secret_key
# Avoid unescaped $ in secrets — Docker Compose treats $VAR as interpolation
CHAINLIT_AUTH_SECRET=your_chainlit_auth_secret
MIKR_REFRESH_SECRET=your_refresh_secret

# SMTP Mail Configurations (e.g. Mailtrap or custom SMTP server)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Mailbox for the scheduled alerts (Dashboard emailService); uses the SMTP_* mailbox when unset
ALERT_SMTP_HOST=smtp.outlook.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=your_alert_mailbox
ALERT_SMTP_PASS=your_alert_mailbox_password

# Used by projectMediaFileDownload.py (Office365)
SENDER_EMAIL=your_sender_email@domain.com
SENDER_PASSWORD=your_sender_password
BASE_URL=http://https://sagarmanthan.ntcpwc.net:8443

# Google reCAPTCHA Secret Key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# RSA Decryption Private Key (MUST match the public key in frontend .env.example)
RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIICXgIBAAKBgQCtKadrC6eRM6dVJzCMaYEb9u6J3bmQ5yzMER6Jsa5xr2SoVRwn\nphar1ch/fqz+nWKu52Phztsx6r9ZE3Q7yDjXzsFrJ3ynq8UGpdHAVJ0BkL2bXp+E\n1ZDbUI0Xl8Dv6hWCQXlvkGi6fNOHSYlqNgNQHsZ1IlQP88vCQeRFJf3bCQIDAQAB\nAoGAKXV+ow+ASDCQ0L94TTX5doORqyqOAlaHEDjNEfSbqpZuyCrQeeG3Ld8aiQQA\nUVnHRc8ax/ap3nKw65fPzXxrt0EdncLjOLS+SMcpShaDD4h6bk9PYRG9p5/00NFN\n/6m0JkHD5xUYvrYvU/Yo0sS12lBQt6jhf5W61XOkMhcTm4ECQQD+yNd/BOtCcwIl\nHstC2cPr0ut2bQ7UgpBWzcwGQRZc69yMet6427XG15oVKxiYAtTEN6dKBkRSoJdO\n3M/rVBEZAkEArf0hdehVQG9X9qPDjmx+JS/AmgEFImiKvcQL69bLHg9dRPjwh6zN\npgspmFWfwfuabmV+pEnv/f6f54hiVPOncQJBAOKlUSW5/3nGCyNwSEp4o1OV9kYL\n78RVPQcq3RK3NaiFXFVPO+9f600uH/AyvRcEdbby9wrflkmWd+L8hK0HxIkCQQCK\nrq/TGcOKPrXwpAwmJBhQb8Wne5SqHoYoSHHwJB928Gw5o+ulWXn6Ff+rquRSbMhl\nooTVUxH2dNTkanNmn2ghAkEA8vuv2fNrQXH0bSkiDwZGwCzbskS/3fBiXuI2Lu3n\nJ209E6WnEWR0lMMaPJIhXAtv3iH32m+WaO/Eyml9QhbwCQ==\n-----END RSA PRIVATE KEY-----"

# Refresh-token cookie sent over HTTPS only (true) or also over plain HTTP (false).
# Unset: true when NODE_ENV=production. Set false for a deployment served over http://,
# or the browser drops the cookie and sessions end after 30 minutes.
COOKIE_SECURE=

# --- Infrastructure / hardening (all optional; sensible defaults apply if unset) ---

# Number of reverse-proxy hops in front of Node, for correct client-IP detection + rate limiting.
#   1 = one proxy (e.g. nginx) in front   |   2 = two hops (e.g. host nginx -> container nginx)
#   false = none (Node faces clients directly)
# Set this too high and clients can spoof X-Forwarded-For to bypass IP rate limits.
TRUST_PROXY=1

# Rate limiting (express-rate-limit). Window applies to both limiters.
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=1000           # max requests per IP per window (global)
AUTH_RATE_LIMIT_MAX=20        # max FAILED login attempts per account (email) per window

# In-memory response cache (node-cache) for shared master/dropdown GETs.
CACHE_TTL_SECONDS=300

# Circuit breaker (opossum) around external calls (e.g. reCAPTCHA verification).
BREAKER_TIMEOUT_MS=8000       # fail a call that runs longer than this
BREAKER_ERROR_THRESHOLD=50    # open the breaker at >= this % failures
BREAKER_RESET_MS=30000        # stay open this long before a half-open trial
